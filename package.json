{
  "name": "sinister-six-digital-signage",
  "version": "1.0.0",
  "type": "module",
  "description": "Vertical digital signage display for Dr. Paul's door (CS 3250 Group 6)",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,css,html}\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --passWithNoTests",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CS-3250-SinisterSix/Sinister-Six-Digital-Signage.git"
  },
  "keywords": [
    "digital-signage",
    "chromium",
    "signage"
  ],
  "author": "",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/CS-3250-SinisterSix/Sinister-Six-Digital-Signage/issues"
  },
  "homepage": "https://github.com/CS-3250-SinisterSix/Sinister-Six-Digital-Signage#readme",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  }
}
